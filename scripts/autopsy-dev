#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
python="${AUTOPSY_DEV_PYTHON:-"$repo_root/.venv/bin/python"}"

# autopsy_memory.dev_cli forces the AutopsyDev support tree unless explicitly overridden.
if [[ ! -x "$python" ]]; then
  cat >&2 <<EOF
autopsy-dev wrapper could not find an executable Python at:
  $python

Create the development virtualenv first, or set AUTOPSY_DEV_PYTHON to a Python
that can import this checkout.
EOF
  exit 127
fi

export PYTHONPATH="$repo_root/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$python" -m autopsy_memory.dev_cli "$@"
