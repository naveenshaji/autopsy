{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Autopsy Observatory",
  "version": "0.1.0",
  "identifier": "com.autopsy.observatory",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Autopsy Observatory",
        "width": 1320,
        "height": 880,
        "minWidth": 1040,
        "minHeight": 720,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
