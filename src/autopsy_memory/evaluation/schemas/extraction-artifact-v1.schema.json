{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/naveenshaji/autopsy/main/src/autopsy_memory/evaluation/schemas/extraction-artifact-v1.schema.json",
  "title": "Autopsy external extraction artifact v1",
  "type": "object",
  "required": ["schema", "dataset", "dataset_sha256", "granularity", "representation", "track", "corpus_id", "input_corpus_sha256", "extractor", "input", "output", "memories", "relations", "latency_seconds", "diagnostics"],
  "properties": {
    "schema": {"const": "autopsy-external-extraction-artifact/v1"},
    "dataset": {"type": "string", "minLength": 1},
    "dataset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "granularity": {"enum": ["turn", "session"]},
    "representation": {"enum": ["audited", "upstream"]},
    "track": {"enum": ["extracted-retrieval", "common-answer"]},
    "corpus_id": {"type": "string", "minLength": 1},
    "input_corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "extractor": {"type": "object"},
    "input": {
      "type": "object",
      "required": ["documents", "characters"],
      "properties": {"documents": {"type": "integer", "minimum": 0}, "characters": {"type": "integer", "minimum": 0}},
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["memories", "characters", "relations"],
      "properties": {"memories": {"type": "integer", "minimum": 0}, "characters": {"type": "integer", "minimum": 0}, "relations": {"type": "integer", "minimum": 0}},
      "additionalProperties": false
    },
    "memories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["memory_id", "title", "text", "timestamp", "expired_at", "source_document_ids"],
        "properties": {
          "memory_id": {"type": "string", "minLength": 1},
          "title": {"type": "string"},
          "text": {"type": "string", "minLength": 1},
          "timestamp": {"type": "string"},
          "expired_at": {"type": "string"},
          "source_document_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "relations": {"type": "array", "items": {"type": "object"}},
    "latency_seconds": {"type": "number", "minimum": 0},
    "diagnostics": {"type": "object"}
  },
  "additionalProperties": false
}
