{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/naveenshaji/autopsy/main/src/autopsy_memory/evaluation/schemas/end-to-end-report-v1.schema.json",
  "title": "Autopsy external end-to-end evaluation report v1",
  "type": "object",
  "required": ["schema", "evaluation", "track", "status", "comparable_run", "qualification", "started_at", "completed_at", "dataset", "configuration", "adapter", "extractor", "generator", "runtime", "cost", "retrieval_channel_counts", "ranking_instability_cases", "leakage_audit", "extraction", "context", "retrieval_metrics", "answer_metrics", "case_errors", "artifacts", "timings", "latency_profiles_seconds", "limitations"],
  "properties": {
    "schema": {"const": "autopsy-external-end-to-end-evaluation/v1"},
    "evaluation": {"const": "external-end-to-end"},
    "track": {"enum": ["extracted-retrieval", "common-answer"]},
    "status": {"enum": ["complete", "completed_with_errors"]},
    "comparable_run": {"type": "boolean"},
    "qualification": {"type": "object"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "dataset": {"type": "object"},
    "configuration": {"type": "object"},
    "adapter": {"type": "object"},
    "extractor": {"type": "object"},
    "generator": {"type": ["object", "null"]},
    "runtime": {"type": "object"},
    "cost": {"type": "object"},
    "retrieval_channel_counts": {"type": "object"},
    "ranking_instability_cases": {"type": "integer", "minimum": 0},
    "leakage_audit": {"type": "object"},
    "extraction": {"type": "object"},
    "context": {"type": "object"},
    "retrieval_metrics": {"type": "object"},
    "answer_metrics": {"type": "object"},
    "case_errors": {"type": "array", "items": {"type": "object"}},
    "artifacts": {"type": "object"},
    "timings": {"type": "object"},
    "latency_profiles_seconds": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
