{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/naveenshaji/autopsy/main/src/autopsy_memory/evaluation/schemas/retrieval-prediction-v1.schema.json",
  "title": "Autopsy external retrieval prediction v1",
  "type": "object",
  "required": ["schema", "dataset", "dataset_sha256", "granularity", "representation", "adapter_id", "track", "adapter_config_sha256", "adapter_package_pin", "adapter_source_pin", "adapter_execution", "adapter_cost", "case_id", "corpus_id", "category", "query", "ranked_document_ids", "route", "retrieval_limit", "latency_seconds", "repetitions", "ingestion", "diagnostics"],
  "properties": {
    "schema": {"const": "autopsy-external-retrieval-prediction/v1"},
    "dataset": {"type": "string"},
    "dataset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "granularity": {"enum": ["turn", "session"]},
    "representation": {"enum": ["audited", "upstream"]},
    "adapter_id": {"type": "string"},
    "track": {"type": "string"},
    "adapter_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adapter_package_pin": {"type": "object"},
    "adapter_source_pin": {"type": "object"},
    "adapter_execution": {"type": "object"},
    "adapter_cost": {"type": "object"},
    "case_id": {"type": "string"},
    "corpus_id": {"type": "string"},
    "category": {"type": "string"},
    "query": {"type": "string"},
    "ranked_document_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "route": {"type": "string"},
    "retrieval_limit": {"type": "integer", "minimum": 1},
    "retrieval_reasons": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
    "latency_seconds": {"type": "number", "minimum": 0},
    "repetitions": {"type": "integer", "minimum": 1},
    "ingestion": {"type": "object"},
    "diagnostics": {"type": "object"}
  },
  "additionalProperties": false
}
